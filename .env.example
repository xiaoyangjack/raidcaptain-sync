# RaidCaptain Sync Server - 环境变量模板
# 复制此文件为 .env 并填入实际值

# ── 数据库 ────────────────────────────────────────────────────
RAID_SYNC_DIR=/data
RAID_SYNC_DB=/data/sync.db

# ── OSS 存储（阿里云）──────────────────────────────────────────
# 推荐创建专用子用户 + AccessKey，权限仅限 OSS
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=raidcaptain-evidence
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_REGION=cn-hangzhou
# OSS 内网链接（ECS 同区域免流量费）
OSS_INTERNAL=false

# ── 认证 ──────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
PARENT_TOKEN_EXPIRY_DAYS=30

# ── 服务器 ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── 限流（可选）────────────────────────────────────────────────
# RATE_LIMIT=30 per minute per IP
